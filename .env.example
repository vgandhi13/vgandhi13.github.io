# Public project connection details, safe to include in the browser build.
# Never use a secret key or service_role key in a PUBLIC_ variable.
# Both values are required to build the site. Collections uses Supabase only.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring passkeys for the live site's domain in Supabase.
PUBLIC_SUPABASE_PASSKEYS=false
