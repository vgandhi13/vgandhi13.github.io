---
// /interests/ was renamed to /me/. Keep old links working.
const target = '/me/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to /me/</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline>location.replace('/me/' + location.hash);</script>
  </head>
  <body>
    <p>This page moved to <a href={target}>/me/</a>.</p>
  </body>
</html>
