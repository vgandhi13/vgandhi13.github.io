      const submit = form.querySelector('[type="submit"]');
      const privateContents = [...root.querySelectorAll('[data-private-content]')];
      const payload = JSON.parse(root.querySelector('#philosophy-payload').textContent);
      let unlocked = false;
      let unlocking = false;
      let attempt = 0;
      if (tabs.length < 2) return;

      const isLocked = (panel) => panel.dataset.locked === 'true' && !unlocked;
      const select = (panelId, focus) => {
        const target = panels.find((panel) => panel.id === panelId);
        if (!target || isLocked(target)) return;
        for (const tab of tabs) {
          const on = tab.dataset.target === panelId;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        }
        for (const panel of panels) panel.hidden = panel.id !== panelId;
      };

      for (const tab of tabs) {
        tab.addEventListener('click', () => select(tab.dataset.target));
        tab.addEventListener('keydown', (event) => {
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!step && event.key !== 'Home' && event.key !== 'End') return;
          event.preventDefault();
          const visible = tabs.filter((item) => !item.hidden);
          const index = visible.indexOf(tab);
          const next = event.key === 'Home' ? visible[0] : event.key === 'End' ? visible.at(-1) :
            visible[(index + step + visible.length) % visible.length];
          select(next.dataset.target, true);
        });
      }

      root.classList.add('is-interactive');
      picker.hidden = false;

      // A shared link points at one entry, which may sit in the panel that is not
      // open. Resolve the hash to its panel first; collection-key hashes open panels
      // directly, and the build refuses an entry slug that would collide with one.
      const hashEntry = () => {
        try { return decodeURIComponent(location.hash.slice(1)); } catch { return ''; }
      };
      const hashPanel = () => {
        const hash = hashEntry();
        return panels.find((panel) => panel.id === 'panel-' + hash) ||
          (hash ? document.getElementById(hash)?.closest('.collection-panel') : null);
      };
      const openHashPanel = () => {
        const target = hashPanel();
        select(target && !isLocked(target) ? target.id : panels[0].id);
      };
      const jumpToEntry = () => {
        const entry = document.getElementById(hashEntry());
        if (entry?.closest('.collection-panel')?.hidden === false) {
          if (entry.matches('.principle-note')) entry.open = true;
          entry.scrollIntoView({ block: 'center' });
        }
      };
      openHashPanel();

      // Only decrypted content is mounted. Relocking removes it from the DOM;
      // no password, key, or plaintext is saved to browser storage.
      const clearError = () => {
        error.hidden = true;
        error.textContent = '';
        password.removeAttribute('aria-invalid');
      };
      const setBusy = (busy) => {
        unlocking = busy;
        form.setAttribute('aria-busy', String(busy));
        password.readOnly = busy;
        submit.disabled = busy;
        submit.textContent = busy ? 'Unlocking…' : 'Unlock';
      };
      const clearPrivate = () => {
        for (const content of privateContents) {
          for (const share of content.querySelectorAll('.share')) clearTimeout(share.resetTimer);
          content.replaceChildren();
        }
      };
      lock.addEventListener('click', () => {
        if (!unlocked) {
          form.reset();
          clearError();
          dialog.showModal();
          return;
        }
        const current = panels.find((panel) => !panel.hidden);
        const privateHash = hashPanel()?.dataset.locked === 'true';
        unlocked = false;
        clearPrivate();
        for (const tab of tabs) {
          if (document.getElementById(tab.dataset.target).dataset.locked === 'true') tab.hidden = true;
        }
        select(current && !isLocked(current) ? current.id : panels[0].id);
        if (privateHash) {
          window.history.replaceState(null, '', location.pathname + location.search);
        }
        lock.setAttribute('aria-label', 'Unlock private collections');
        lock.setAttribute('title', 'Unlock private collections');
        lock.setAttribute('aria-haspopup', 'dialog');
        lock.setAttribute('aria-controls', dialog.id);
        lock.querySelector('[data-lock-shackle]').setAttribute('d', 'M7 11V7a5 5 0 0 1 10 0v4');
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (unlocking) return;
        const request = ++attempt;
        const passphrase = password.value;
        password.value = '';
        clearError();
        setBusy(true);
        try {
          if (!globalThis.crypto?.subtle) throw new Error('Web Crypto is unavailable.');
          const { decryptEntries, renderEntries, renderPrinciples, renderPhilosophyNotes } = await import(form.dataset.cryptoModule);
          const content = await decryptEntries(payload, passphrase);
          if (request !== attempt || !dialog.open) return;
          // Render all before mounting any: an invalid collection fails closed.
          const philosophy = content.philosophy.length || !content.philosophyNotes?.length ?
            renderEntries(content.philosophy) : document.createDocumentFragment();
          const principles = renderPrinciples(content.firstPrinciples);
          philosophy.append(renderPhilosophyNotes(content.philosophyNotes ?? []));
          root.querySelector('#philosophy-content').replaceChildren(philosophy);
          root.querySelector('#first-principles-content').replaceChildren(principles);
          unlocked = true;
          for (const tab of tabs) tab.hidden = false;
          dialog.close();
          lock.setAttribute('aria-label', 'Lock private collections');
          lock.setAttribute('title', 'Lock private collections');
          lock.removeAttribute('aria-haspopup');
          lock.setAttribute('aria-controls', panels.filter(panel => panel.dataset.locked === 'true').map(panel => panel.id).join(' '));
          lock.querySelector('[data-lock-shackle]').setAttribute('d', 'M7 11V7a5 5 0 0 1 9.9-1');
          const target = hashPanel();
          select(target?.dataset.locked === 'true' ? target.id : 'panel-philosophy', true);
          jumpToEntry();
        } catch (failure) {
          if (request !== attempt || !dialog.open) return;
          clearPrivate();
          error.textContent = failure.name === 'OperationError' ?
            'Incorrect password. Try again.' : 'Could not unlock the collection. Please try again.';
          error.hidden = false;
          if (failure.name === 'OperationError') password.setAttribute('aria-invalid', 'true');
          password.focus();
        } finally {
          if (request === attempt) setBusy(false);
        }
      });
      password.addEventListener('input', clearError);
      dialog.querySelector('[data-unlock-cancel]').addEventListener('click', () => dialog.close());
      dialog.addEventListener('close', () => {
        attempt++;
        setBusy(false);
        form.reset();
        clearError();
      });

      // The shuffle moves the browser's initial anchor target. Repeat the jump
      // after layout settles, and open the right panel for subsequent hash changes.
      addEventListener('DOMContentLoaded', jumpToEntry);
      addEventListener('hashchange', () => {
        openHashPanel();
        jumpToEntry();
      });
    })();

    // Share controls copy an absolute link. They stay real anchors, so with no JS
    // (or no clipboard access) clicking still jumps to the entry and puts the
    // shareable URL in the address bar.
    if (navigator.clipboard) {
      // Delegation also covers private entries added after decryption.
      document.getElementById('collections').addEventListener('click', async (event) => {
        const btn = event.target.closest('.share');
        if (!btn) return;
        event.preventDefault();
        const slug = btn.dataset.slug;
        try {
          await navigator.clipboard.writeText(location.origin + location.pathname + '#' + slug);
        } catch {
          location.hash = slug;
          return;
        }
        const label = btn.querySelector('.share-live');
        btn.classList.add('copied');
        label.textContent = 'Copied';
        clearTimeout(btn.resetTimer);
        btn.resetTimer = setTimeout(() => {
          btn.classList.remove('copied');
          label.textContent = 'Copy link';
        }, 1600);
      });
    }
  </script>
</Base>

<style>
  /* Collection picker. Base state is public panels stacked under their own <h2>, so
     the page reads without JS; .is-interactive (added by the script) reveals the
     tab bar, drops the headings, and collapses to one panel at a time. */
  .collection-picker {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  /* Explicit rules preserve hidden states when a component has its own display. */
  .collection-picker[hidden],
  .collection-tab[hidden],
  .collection-panel[hidden],
  .collection-unlock-error[hidden] {
    display: none;
  }

  .collection-tabs {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    min-width: 0;
    gap: 0 1.25rem;
  }

  .collection-tab {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.45rem 0.15rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .collection-tab:hover {
    color: var(--text);
  }

  /* colour and a rule, deliberately not font-weight: bolding the selected tab
     changes its width, so the bar reflows every time you switch */
  .collection-tab[aria-selected='true'] {
    color: var(--heading);
    border-bottom-color: var(--link);
  }

  .collection-tab:focus-visible,
  .collection-lock:focus-visible,
  .collection-dialog button:focus-visible,
  .collection-dialog input:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .collection-lock {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -0.2rem;
    padding: 0;
    color: var(--text-muted);
    background: none;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .collection-lock:hover {
    color: var(--heading);
  }

  .collection-dialog {
    width: min(22rem, calc(100% - 3rem));
    padding: 1.5rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .collection-dialog::backdrop {
    background: rgb(0 0 0 / 40%);
  }

  .collection-dialog h2 {
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
  }

  .collection-dialog label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }

  .collection-dialog input {
    width: 100%;
    padding: 0.55rem 0.65rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .collection-unlock-error {
    margin: 0.65rem 0 0;
    font-size: 0.85rem;
  }

  .collection-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .collection-dialog button {
    padding: 0.45rem 0.8rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
  }

  .collection-dialog .collection-unlock-submit {
    color: var(--bg);
    background: var(--link);
    border-color: var(--link);
  }

  .collection-heading {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .collections.is-interactive .collection-heading {
    display: none;
  }

  /* only for the stacked no-JS case: a hidden panel is still a previous sibling,
     so unscoped this would also indent the second panel when it is the selected tab */
  .collections:not(.is-interactive) .collection-panel + .collection-panel {
    margin-top: 2.75rem;
  }

  .intro {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>

{/* These shared card styles are global and namespaced: decrypted cards are created
    by JS and cannot inherit Astro's scoped attributes. */}
<style is:global>
  /* First Principles reads as a notebook, not a list of quotations. Native
     disclosures expand each title into a full reading surface. */
  .collections .principle-note {
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    scroll-margin-top: 2rem;
    overflow-wrap: anywhere;
  }

  .collections .principle-note > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.3rem 1.5rem;
    list-style: none;
    cursor: pointer;
    border-radius: 7px;
  }

  .collections .principle-note > summary::-webkit-details-marker {
    display: none;
  }

  .collections .principle-note > summary:hover {
    background: var(--surface);
  }

  .collections .principle-note > summary:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }

  .collections .principle-note[open] > summary {
    border-bottom: 1px solid var(--border);
    border-radius: 7px 7px 0 0;
  }

  .collections .principle-heading {
    min-width: 0;
  }

  .collections .principle-title {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.35;
  }

  .collections .principle-summary {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .collections .principle-date {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .collections .principle-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .collections .principle-toggle svg {
    flex-shrink: 0;
  }

  .collections .principle-close,
  .collections .principle-note[open] .principle-read {
    display: none;
  }

  .collections .principle-note[open] .principle-close {
    display: inline;
  }

  .collections .principle-note[open] .principle-toggle svg {
    transform: rotate(90deg);
  }

  .collections .principle-reading {
    padding: 1.5rem;
  }

  .collections .principle-body > :first-child {
    margin-top: 0;
  }

  .collections .principle-body > :last-child {
    margin-bottom: 0;
  }

  .collections .principle-placeholder {
    color: var(--text-muted);
    font-style: italic;
  }

  .collections .principle-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 480px) {
    .collections .principle-note > summary,
    .collections .principle-reading {
      padding: 1.1rem;
    }
  }

  .collections .empty {
    color: var(--text-muted);
    font-style: italic;
  }

  .collections .quote-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collections .quote-list li {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: 8px;
    scroll-margin-top: 2rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .collections .quote-list li:hover {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* the excerpt someone was linked to, so a shared link lands somewhere obvious */
  .collections .quote-list li:target {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* Base.astro styles blockquotes as muted pull-quotes with a left rule; on this
     page the quote *is* the content, so it gets body color and no rule. */
  .collections .quote-list blockquote {
    margin: 0;
    padding-left: 0;
    border-left: none;
    color: var(--text);
    font-size: 1.05rem;
  }

  /* history and cognitive-science entries are prose, not quotations, so they get
     ordinary body size rather than the slightly-raised pull-quote size */
  .collections .story {
    font-size: 1rem;
  }

  .collections .quote-list blockquote p,
  .collections .story p {
    margin: 0 0 0.9rem;
  }

  .collections .quote-list blockquote p:last-child,
  .collections .story p:last-child {
    margin-bottom: 0;
  }

  /* the story subject or concept title. It sits above the body, where an idea's
     attribution sits below, because this is a heading rather than a speaker. */
  .collections .subject {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--heading);
  }

  .collections .subject .year {
    font-weight: 400;
    color: var(--text-muted);
  }

  /* a figure from the same source as the quote. These are black-on-white line
     drawings, and a rectangle of paper sitting on the card reads as a slab in
     either theme, so the flat background is blended away instead: multiply drops
     white onto --surface, and dark mode inverts first so screen drops the black.
     Both are lossless only while the art is grayscale, so keep it that way. */
  .collections .quote-figure {
    margin: 1.1rem 0 0;
  }

  .collections .quote-figure img {
    display: block;
    width: min(100%, 460px);
    margin: 0 auto;
    mix-blend-mode: multiply;
  }

  :root[data-theme='dark'] .collections .quote-figure img {
    filter: invert(1);
    mix-blend-mode: screen;
  }

  /* colored art on white: inverting it would hue-flip every fill, so it renders
     plainly and accepts the white panel in dark mode */
  .collections .quote-figure img.plain,
  :root[data-theme='dark'] .collections .quote-figure img.plain {
    mix-blend-mode: normal;
    filter: none;
  }

  .collections .quote-figure figcaption {
    text-align: center;
  }

  /* the share link tracks the BOTTOM of the text block, not the attribution line:
     with a `note` present the attribution is no longer the card's last row, and
     baseline-aligning left the link stranded halfway up the card */
  .collections .meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .collections .meta-text {
    min-width: 0;
  }

  .collections .attribution {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .collections .share {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .collections .share:hover,
  .collections .share:focus-visible {
    color: var(--link);
    background: var(--bg);
  }

  .collections .share.copied,
  .collections .share.copied:hover {
    color: var(--heading);
    background: var(--bg);
  }

  .collections .share svg {
    flex-shrink: 0;
  }

  /* Both labels occupy one grid cell, so the control stays as wide as the longer
     one when the text swaps to "Copied". Without this the label narrows, .meta
     (space-between) hands the freed width to .meta-text, and the commentary
     re-wraps to fewer lines: the whole card visibly shrinks on click. */
  .collections .share-text {
    display: inline-grid;
  }

  .collections .share-text > * {
    grid-area: 1 / 1;
  }

  .collections .share-sizer {
    visibility: hidden;
  }

  /* my own commentary, not the speaker's: the rule and the lighter register are
     what keep the two voices apart once the card is screenshotted or shared */
  .collections .commentary {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* a short rule rather than a full-width one: --border sits almost on top of
     --surface, so the hairline divider it would draw here is invisible */
  .collections .commentary::before {
    content: '';
    display: block;
    width: 26px;
    margin-bottom: 0.55rem;
    border-top: 2px solid var(--text-muted);
    opacity: 0.45;
  }

  /* the rule introduces the commentary block, so only the first paragraph draws it */
  .collections .commentary + .commentary {
    margin-top: 0.6rem;
  }

  .collections .commentary + .commentary::before {
    display: none;
  }

  .collections .added {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .collections .attribution::before {
    content: '\2014\00a0';
  }

  .collections .source {
    font-style: italic;
  }

  .collections .source strong {
    font-style: normal;
  }

  .collections .paraphrased {
    font-style: normal;
  }
</style>
