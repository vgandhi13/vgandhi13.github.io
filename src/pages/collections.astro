// History: a small moment that turned out to decide a lot. Same card as an idea, but
// `subject` in place of `author`, so the body renders as prose rather than a quote and
// the attribution moves above it. Everything else (note, added, figures, share link)
// works exactly as it does for an idea.
const history: Entry[] = [
  {
    subject: 'Morris Chang',
    year: '1955',
    text: [
      'In 1955, Morris Chang suffered what he then considered the biggest failure of his life: ' +
        'he failed his Ph.D. qualifying exams at MIT for the second time, meaning he could not ' +
        'continue his doctorate. Forced to look for a job, he got two offers: Ford, the more ' +
        'prestigious of the two, and Sylvania Electric Products, a lesser-known electronics ' +
        'company working on a relatively new technology called \u201Ctransistors\u201D.',
      'Ford offered Chang a salary of $479 a month. Sylvania offered him $480 a month. Chang ' +
        'actually preferred the prestige and charm of Ford. However, finding it odd that ' +
        'Ford\u2019s offer was exactly $1 less than Sylvania\u2019s, he decided to call the Ford ' +
        'recruiter who had previously been very kind to him. He politely asked if Ford would ' +
        'match Sylvania\u2019s offer so he could make an even $480 a month.',
      'Instead of negotiating, the recruiter instantly turned hostile and dismissive. He snapped ' +
        'at Chang, telling him that Ford\u2019s salary structure was set and that he would not get ' +
        'a single cent more. Insulted by the recruiter\u2019s rude attitude, an angry Chang ' +
        'rejected Ford\u2019s offer out of principle and signed with Sylvania. That is how he ' +
        'entered the semiconductor industry. This $1 snub altered the course of tech history.',
    ],
    note: 'One of the most famous butterfly effect moments in modern tech history.',
    added: '2026-09-10',
  },
  {
    subject: 'Vasili Arkhipov',
    year: '1962',
    text: [
      'A Soviet submarine named B-59 was hiding near Cuba. The U.S. Navy dropped non-lethal ' +
        'depth charges to force the submarine to surface. The submarine was cut off from radio ' +
        'contact. The crew felt the heat and shaking of the charges. They thought World War III ' +
        'had started.',
      'The captain and the political officer wanted to fire a nuclear-armed torpedo. Vasili ' +
        'Arkhipov was second-in-command and the flotilla chief of staff. Rules required his ' +
        'agreement to fire the weapon. He argued they were not under a real attack and ' +
        'convinced the captain to surface instead.',
    ],
    note: 'This single moment prevented World War III and the nuclear winter that would likely have followed.',
    added: '2026-09-10',
  },
];

const addedOn = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

const slugify = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

// Slugs are never derived from array position: a shared link has to keep pointing at
// the same entry no matter what gets added above it later. So a second entry under the
// same name collides on purpose and fails the build, and you resolve it by pinning `id`
// on the NEW one, which leaves the already-shared link on the old one untouched.
// The map spans BOTH collections, so moving an entry between them keeps its link, and a
// slug can never be ambiguous about which panel it opens.
const collections = [
  { key: 'ideas', label: 'Ideas', items: quotes, shuffle: true },
  { key: 'history', label: 'History', items: history, shuffle: false },
];

const nameOf = (q: Entry) => q.author ?? q.subject;
const firstWords = (q: Entry) =>
  slugify((Array.isArray(q.text) ? q.text[0] : q.text).split(' ').slice(0, 3).join(' '));

// Seeded with the collection keys: the script opens a panel when the hash names one, so
// an entry slugged "history" would be a link that lands on the wrong thing.
const seen = new Map(collections.map((c) => [c.key, `the ${c.label} panel`]));

const sections = collections.map((c) => ({
  ...c,
  entries: c.items.map((q) => {
    const name = nameOf(q);
    if (!q.id && !name) {
      throw new Error(
        `An entry with no author or subject has no name to slug from, so it needs an ` +
          `explicit id. Add one, e.g. id: '${firstWords(q)}'.`
      );
    }
    const slug = q.id ?? slugify(name!);
    const clash = seen.get(slug);
    if (clash) {
      throw new Error(
        `Duplicate anchor "#${slug}" (${clash} and ${name ?? `#${slug}`}). Add an explicit id ` +
          `to the newer entry, e.g. id: '${slug}-${firstWords(q)}'. Do not renumber the ` +
          `existing one: its link is already out in the world.`
      );
    }
    seen.set(slug, name ?? `#${slug}`);
    return { ...q, slug };
  }),
}));
