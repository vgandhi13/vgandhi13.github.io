<Base title="Collections · Varun Gandhi" description="Ideas and stories I keep coming back to.">
  <h1>Collections</h1>
  <p class="intro">
    Ideas and stories I keep coming back to.
  </p>

  <div class="collections" id="collections">
    {/* Ships hidden and is revealed by the script, so no-JS readers get both
        collections stacked under their own headings rather than dead buttons. */}
    <div class="collection-tabs" role="tablist" aria-label="Collections" hidden>
      {sections.map((s, i) => (
        <button
          type="button"
          class="collection-tab"
          role="tab"
          id={`tab-${s.key}`}
          aria-controls={`panel-${s.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-target={`panel-${s.key}`}
        >{s.label}</button>
      ))}
    </div>

    {sections.map((s) => (
      <section class="collection-panel" id={`panel-${s.key}`} role="tabpanel" aria-labelledby={`tab-${s.key}`}>
        <h2 class="collection-heading">{s.label}</h2>
        {s.entries.length === 0 ? (
          <p class="empty">Nothing here yet.</p>
        ) : (
          <ul class="quote-list" data-shuffle={s.shuffle ? 'true' : undefined}>
            {s.entries.map((q) => (
              <li id={q.slug}>
                {/* a history entry names its subject above the story; an idea attributes
                    below, in .attribution, where the em dash belongs */}
                {q.subject && (
                  <p class="subject">{q.subject}{q.year && <span class="year">, {q.year}</span>}</p>
                )}
                {/* set:html so an entry can bold the term it defines. Safe because every
                    `text` value is authored in this file, never user input. */}
                {q.subject ? (
                  <div class="story">
                    {(Array.isArray(q.text) ? q.text : [q.text]).map((para) => <p set:html={para} />)}
                  </div>
                ) : (
                  <blockquote>
                    {(Array.isArray(q.text) ? q.text : [q.text]).map((para) => <p set:html={para} />)}
                  </blockquote>
                )}
                {q.image && (
                  <figure class="quote-figure">
                    <img
                      src={q.image.src}
                      alt={q.image.alt}
                      class={q.image.plain ? 'plain' : undefined}
                      style={q.image.width ? `width: min(100%, ${q.image.width}px)` : undefined}
                      loading="lazy"
                    />
                    {q.image.credit && (
                      <figcaption>
                        {q.image.creditUrl
                          ? <a href={q.image.creditUrl} target="_blank" rel="noopener">{q.image.credit}</a>
                          : q.image.credit}
                      </figcaption>
                    )}
                  </figure>
                )}
                {q.svg && (
                  <figure class="quote-figure">
                    <Fragment set:html={q.svg.markup} />
                    {q.svg.credit && (
                      <figcaption>
                        {q.svg.creditUrl
                          ? <a href={q.svg.creditUrl} target="_blank" rel="noopener">{q.svg.credit}</a>
                          : q.svg.credit}
                      </figcaption>
                    )}
                  </figure>
                )}
                <div class="meta">
                  <div class="meta-text">
                    {/* an idea with no author renders no attribution line, and the em dash
                        goes with it since it lives on .attribution::before */}
                    {q.author && (
                      /* kept on one line: a line break here renders as a space before the comma */
                      <p class="attribution">
                        {q.author}{q.source && <span class="source">, {q.url ? <a href={q.url} target="_blank" rel="noopener">{q.source}</a> : q.source}</span>}{q.paraphrased && <span class="paraphrased"> (paraphrased)</span>}
                      </p>
                    )}
                    {q.note && (Array.isArray(q.note) ? q.note : [q.note]).map((n) => <p class="commentary" set:html={n} />)}
                    {q.added && (
                      <p class="added">Added <time datetime={q.added}>{addedOn(q.added)}</time></p>
                    )}
                  </div>
                  <a class="share" href={`#${q.slug}`} data-slug={q.slug} aria-label={q.author ? `Copy a link to this idea by ${q.author}` : q.subject ? `Copy a link to this story about ${q.subject}` : 'Copy a link to this entry'}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                    </svg>
                    <span class="share-text">
                      <span class="share-sizer" aria-hidden="true">Copy link</span>
                      <span class="share-live">Copy link</span>
                    </span>
                  </a>
                </div>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
  <script is:inline>
    // Fisher-Yates shuffle, run inline right after the list so it reorders before
    // first paint (same pre-paint trick as the theme script in Base.astro). Only
    // lists that opted in: History is a set of dated stories and reads in order.
    // No-JS visitors simply get the authored order.
    for (const list of document.querySelectorAll('.quote-list[data-shuffle]')) {
      const items = Array.from(list.children);
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      for (const item of items) list.append(item);
    }

    // Collection picker. Runs before DOMContentLoaded so the right panel is already
    // open when the hash jump below fires.
    (() => {
      const root = document.getElementById('collections');
      const bar = root && root.querySelector('.collection-tabs');
      if (!bar) return;
      const tabs = [...bar.querySelectorAll('.collection-tab')];
      const panels = [...root.querySelectorAll('.collection-panel')];
      if (tabs.length < 2) return;

      const select = (panelId, focus) => {
        for (const tab of tabs) {
          const on = tab.dataset.target === panelId;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          if (on && focus) tab.focus();
        }
        for (const panel of panels) panel.hidden = panel.id !== panelId;
      };

      for (const [index, tab] of tabs.entries()) {
        tab.addEventListener('click', () => select(tab.dataset.target));
        tab.addEventListener('keydown', (event) => {
          const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          event.preventDefault();
          const next = tabs[(index + step + tabs.length) % tabs.length];
          select(next.dataset.target, true);
        });
      }

      root.classList.add('is-interactive');
      bar.hidden = false;

      // A shared link points at one entry, which may sit in the panel that is not
      // open. Resolve the hash to its panel first; #ideas and #history open a panel
      // directly, and the build refuses an entry slug that would collide with either.
      const hash = decodeURIComponent(location.hash.slice(1));
      const byKey = hash && document.getElementById('panel-' + hash);
      const byEntry = hash && document.getElementById(hash)?.closest('.collection-panel');
      select((byKey || byEntry || panels[0]).id);
    })();

    // The shuffle above moves the element the browser already scrolled to, so a
    // shared #link lands at the wrong offset. Re-run the jump once layout settles.
    addEventListener('DOMContentLoaded', () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id) document.getElementById(id)?.scrollIntoView({ block: 'center' });
    });

    // Share controls copy an absolute link. They stay real anchors, so with no JS
    // (or no clipboard access) clicking still jumps to the entry and puts the
    // shareable URL in the address bar.
    if (navigator.clipboard) {
      for (const btn of document.querySelectorAll('.share')) {
        btn.addEventListener('click', async (event) => {
          event.preventDefault();
          const slug = btn.dataset.slug;
          try {
            await navigator.clipboard.writeText(location.origin + location.pathname + '#' + slug);
          } catch {
            location.hash = slug;
            return;
          }
          const label = btn.querySelector('.share-live');
          btn.classList.add('copied');
          label.textContent = 'Copied';
          clearTimeout(btn.resetTimer);
          btn.resetTimer = setTimeout(() => {
            btn.classList.remove('copied');
            label.textContent = 'Copy link';
          }, 1600);
        });
      }
    }
  </script>
</Base>

<style>
  /* Collection picker. Base state is both panels stacked under their own <h2>, so
     the page reads without JS; .is-interactive (added by the script) reveals the
     tab bar, drops the headings, and collapses to one panel at a time. */
  .collection-tabs {
    display: flex;
    gap: 1.25rem;
    margin: 0 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  /* display: flex above would otherwise beat the browser's [hidden] rule, leaving
     a dead tab bar on the page for readers without JS */
  .collection-tabs[hidden] {
    display: none;
  }

  .collection-tab {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.45rem 0.15rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .collection-tab:hover {
    color: var(--text);
  }

  /* colour and a rule, deliberately not font-weight: bolding the selected tab
     changes its width, so the bar reflows every time you switch */
  .collection-tab[aria-selected='true'] {
    color: var(--heading);
    border-bottom-color: var(--link);
  }

  .collection-tab:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .collection-heading {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .collections.is-interactive .collection-heading {
    display: none;
  }

  /* only for the stacked no-JS case: a hidden panel is still a previous sibling,
     so unscoped this would also indent the second panel when it is the selected tab */
  .collections:not(.is-interactive) .collection-panel + .collection-panel {
    margin-top: 2.75rem;
  }

  .intro {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
  }

  .quote-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quote-list li {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: 8px;
    scroll-margin-top: 2rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .quote-list li:hover {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* the excerpt someone was linked to, so a shared link lands somewhere obvious */
  .quote-list li:target {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* Base.astro styles blockquotes as muted pull-quotes with a left rule; on this
     page the quote *is* the content, so it gets body color and no rule. */
  blockquote {
    margin: 0;
    padding-left: 0;
    border-left: none;
    color: var(--text);
    font-size: 1.05rem;
  }

  /* a history entry is retold, not quoted, so it gets ordinary prose at body size
     rather than the slightly-raised pull-quote size */
  .story {
    font-size: 1rem;
  }

  blockquote p,
  .story p {
    margin: 0 0 0.9rem;
  }

  blockquote p:last-child,
  .story p:last-child {
    margin-bottom: 0;
  }

  /* who and when the story is about. Sits above the body, where an idea's
     attribution sits below, because this names the subject rather than a speaker. */
  .subject {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--heading);
  }

  .subject .year {
    font-weight: 400;
    color: var(--text-muted);
  }

  /* a figure from the same source as the quote. These are black-on-white line
     drawings, and a rectangle of paper sitting on the card reads as a slab in
     either theme, so the flat background is blended away instead: multiply drops
     white onto --surface, and dark mode inverts first so screen drops the black.
     Both are lossless only while the art is grayscale, so keep it that way. */
  .quote-figure {
    margin: 1.1rem 0 0;
  }

  .quote-figure img {
    display: block;
    width: min(100%, 460px);
    margin: 0 auto;
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme='dark']) .quote-figure img {
    filter: invert(1);
    mix-blend-mode: screen;
  }

  /* colored art on white: inverting it would hue-flip every fill, so it renders
     plainly and accepts the white panel in dark mode */
  .quote-figure img.plain,
  :global(:root[data-theme='dark']) .quote-figure img.plain {
    mix-blend-mode: normal;
    filter: none;
  }

  .quote-figure figcaption {
    text-align: center;
  }

  /* the share link tracks the BOTTOM of the text block, not the attribution line:
     with a `note` present the attribution is no longer the card's last row, and
     baseline-aligning left the link stranded halfway up the card */
  .meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .meta-text {
    min-width: 0;
  }

  .attribution {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .share:hover,
  .share:focus-visible {
    color: var(--link);
    background: var(--bg);
  }

  .share.copied,
  .share.copied:hover {
    color: var(--heading);
    background: var(--bg);
  }

  .share svg {
    flex-shrink: 0;
  }

  /* Both labels occupy one grid cell, so the control stays as wide as the longer
     one when the text swaps to "Copied". Without this the label narrows, .meta
     (space-between) hands the freed width to .meta-text, and the commentary
     re-wraps to fewer lines: the whole card visibly shrinks on click. */
  .share-text {
    display: inline-grid;
  }

  .share-text > * {
    grid-area: 1 / 1;
  }

  .share-sizer {
    visibility: hidden;
  }

  /* my own commentary, not the speaker's: the rule and the lighter register are
     what keep the two voices apart once the card is screenshotted or shared */
  .commentary {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* a short rule rather than a full-width one: --border sits almost on top of
     --surface, so the hairline divider it would draw here is invisible */
  .commentary::before {
    content: '';
    display: block;
    width: 26px;
    margin-bottom: 0.55rem;
    border-top: 2px solid var(--text-muted);
    opacity: 0.45;
  }

  /* the rule introduces the commentary block, so only the first paragraph draws it */
  .commentary + .commentary {
    margin-top: 0.6rem;
  }

  .commentary + .commentary::before {
    display: none;
  }

  .added {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .attribution::before {
    content: '\2014\00a0';
  }

  .source {
    font-style: italic;
  }

  .paraphrased {
    font-style: normal;
  }
</style>
