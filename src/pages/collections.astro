---
import Base from '../layouts/Base.astro';
import LifeHourglass from '../components/LifeHourglass.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.trim() ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY?.trim() ?? '';
if (!supabaseUrl || !supabaseKey) throw new Error('Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_PUBLISHABLE_KEY.');
if (!supabaseKey.startsWith('sb_publishable_')) throw new Error('Use a Supabase publishable key, never a secret or service role key.');
if (!supabaseUrl.startsWith('https://') || new URL(supabaseUrl).pathname !== '/') throw new Error('Use the HTTPS Supabase project URL without a path.');
const passkeys = import.meta.env.PUBLIC_SUPABASE_PASSKEYS === 'true';

// Only public panel labels live here. Content loads from Supabase after login.
const collections = [
  { key: 'ideas', label: 'Ideas' },
  { key: 'stories', label: 'Stories' },
  { key: 'psychology', label: 'Psychology' },
  { key: 'neuroscience', label: 'Neuroscience' },
  { key: 'learnings', label: 'Learnings' },
  { key: 'thoughts', label: 'Thoughts' },
  { key: 'finance', label: 'Finance' },
  { key: 'social-sciences', label: 'Social Sciences' },
  { key: 'philosophy', label: 'Philosophy' },
  { key: 'first-principles', label: 'First Principles' },
];
---

<Base title="🧠 · Varun Gandhi" description="Things I keep coming back to.">
  <h1><button type="button" id="collections-title" aria-label="Collections">🧠</button></h1>
  <LifeHourglass />
  <div class="collections" id="collections" data-supabase-url={supabaseUrl} data-supabase-key={supabaseKey} data-passkeys={passkeys ? 'true' : undefined}>
    <div class="collection-picker" hidden>
      <div class="collection-tabs" role="tablist" aria-label="Collections">
        {collections.map((s, i) => (
          <button type="button" class="collection-tab" role="tab" id={`tab-${s.key}`}
            aria-controls={`panel-${s.key}`} aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1} data-target={`panel-${s.key}`} hidden>{s.label}</button>
        ))}
      </div>
      <button type="button" class="collection-lock" aria-label="Unlock private collections"
        aria-haspopup="dialog" aria-controls="collection-unlock" title="Unlock private collections" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="10" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 9.9-1" />
        </svg>
      </button>
    </div>
    {collections.map(s => (
      <section class="collection-panel" id={`panel-${s.key}`} role="tabpanel"
        aria-labelledby={`tab-${s.key}`} data-locked="true" hidden>
        <h2 class="collection-heading">{s.label}</h2>
        <div id={`${s.key}-content`} data-private-content></div>
      </section>
    ))}
    <dialog class="collection-dialog" id="collection-unlock" aria-labelledby="collection-unlock-title">
      <form class="collection-unlock-form">
        <h2 id="collection-unlock-title">Private</h2>
        <label for="collection-email">Email</label>
        <input id="collection-email" name="email" type="email" autocomplete="username" required autofocus />
        <label for="collection-password">Password</label>
        <input id="collection-password" name="password" type="password" autocomplete="current-password" aria-describedby="collection-unlock-error" required />
        <p class="collection-unlock-error" id="collection-unlock-error" role="status" hidden></p>
        <div class="collection-dialog-actions">
          <button type="button" data-unlock-cancel>Cancel</button>
          <button type="submit" class="collection-unlock-submit">Sign in</button>
        </div>
        {passkeys && <button type="button" class="collection-passkey-signin" data-passkey-signin hidden>Sign in with passkey</button>}
      </form>
    </dialog>
    {passkeys && <div class="collection-account" hidden>
      <button type="button" data-passkey-register>Add passkey</button>
      <p data-passkey-status role="status" hidden></p>
    </div>}
  </div>
  <script>
    import '../lib/collections-page.js';
  </script>
</Base>

<style>
  #collections-title {
    appearance: none;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  #collections-title:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
  }
  .collection-lock[hidden] { display: none; }
  /* The picker and private panels remain hidden until authenticated loading. */
  .collection-picker {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  /* Explicit rules preserve hidden states when a component has its own display. */
  .collection-picker[hidden],
  .collection-tab[hidden],
  .collection-panel[hidden],
  .collection-unlock-error[hidden] {
    display: none;
  }

  .collection-account[hidden], .collection-passkey-signin[hidden] { display: none; }
  .collection-account { margin-top: 1.5rem; color: var(--text-muted); font-size: 0.85rem; }
  .collection-account button {
    font: inherit;
    padding: 0;
    color: var(--text-muted);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .collection-account p { margin: 0.5rem 0 0; }
  .collection-dialog input + label { margin-top: 0.85rem; }
  .collection-passkey-signin { margin-top: 1rem; width: 100%; }

  .collection-tabs {
    display: flex;
    flex: 1;
    flex-wrap: nowrap;
    min-width: 0;
    gap: 0 1.25rem;
    overflow-x: auto;
    padding: 0.2rem 0.2rem 0.35rem;
    scrollbar-width: thin;
  }

  .collection-tab {
    flex-shrink: 0;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text-muted);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 0.45rem 0.15rem;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .collection-tab:hover {
    color: var(--text);
  }

  /* colour and a rule, deliberately not font-weight: bolding the selected tab
     changes its width, so the bar reflows every time you switch */
  .collection-tab[aria-selected='true'] {
    color: var(--heading);
    border-bottom-color: var(--link);
  }

  .collection-tab:focus-visible,
  .collection-lock:focus-visible,
  .collection-dialog button:focus-visible,
  .collection-dialog input:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .collection-lock {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font: inherit;
    font-size: 0.85rem;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -0.2rem;
    padding: 0;
    color: var(--text-muted);
    background: none;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }

  .collection-lock:hover {
    color: var(--heading);
  }

  .collection-dialog {
    width: min(22rem, calc(100% - 3rem));
    padding: 1.5rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .collection-dialog::backdrop {
    background: rgb(0 0 0 / 40%);
  }

  .collection-dialog h2 {
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
  }

  .collection-dialog label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }

  .collection-dialog input {
    width: 100%;
    padding: 0.55rem 0.65rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .collection-unlock-error {
    margin: 0.65rem 0 0;
    font-size: 0.85rem;
  }

  .collection-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .collection-dialog button {
    padding: 0.45rem 0.8rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    cursor: pointer;
  }

  .collection-dialog .collection-unlock-submit {
    color: var(--bg);
    background: var(--link);
    border-color: var(--link);
  }

  .collection-heading {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .collections.is-interactive .collection-heading {
    display: none;
  }


</style>

{/* These shared card styles are global and namespaced: authenticated cards are created
    by JS and cannot inherit Astro's scoped attributes. */}
<style is:global>
  .collections .entry-reading.is-collapsed {
    max-height: 11.5em;
    overflow: hidden;
  }

  .collections .entry-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0;
    margin-top: 0.25rem;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .collections .entry-read-more:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }

  .collections .entry-read-more[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .collections .learning-filters,
  .collections .learning-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .collections .learning-filter,
  .collections .learning-tag {
    font: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--text-muted);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }
  .collections .learning-filter[aria-pressed='true'],
  .collections .learning-tag[aria-pressed='true'] {
    color: var(--link);
    border-color: var(--link);
    background: var(--surface);
  }
  .collections .learning-filter:focus-visible,
  .collections .learning-tag:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }
  .collections .learning-tags { margin-top: 1rem; }
  .collections .learning-status {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 0.5rem 0 1.25rem;
  }
  .collections .quote-list > li[hidden] { display: none; }
  .collections .philosophy-subcategory[hidden] { display: none; }
  .collections .collection-description {
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }

  /* First Principles reads as a notebook, not a list of quotations. Native
     disclosures expand each title into a full reading surface. */
  .collections .philosophy-aside {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .collections .philosophy-aside blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: inherit;
    color: inherit;
  }

  .collections .principle-note {
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    scroll-margin-top: 2rem;
    overflow-wrap: anywhere;
  }

  .collections .principle-note > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.3rem 1.5rem;
    list-style: none;
    cursor: pointer;
    border-radius: 7px;
  }

  .collections .principle-note > summary::-webkit-details-marker {
    display: none;
  }

  .collections .principle-note > summary:hover {
    background: var(--surface);
  }

  .collections .principle-note > summary:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 3px;
  }

  .collections .principle-note[open] > summary {
    border-bottom: 1px solid var(--border);
    border-radius: 7px 7px 0 0;
  }

  .collections .principle-heading {
    min-width: 0;
  }

  .collections .principle-title {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--heading);
    line-height: 1.35;
  }

  .collections .principle-summary {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .collections .principle-date {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .collections .principle-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .collections .principle-toggle svg {
    flex-shrink: 0;
  }

  .collections .principle-close,
  .collections .principle-note[open] .principle-read {
    display: none;
  }

  .collections .principle-note[open] .principle-close {
    display: inline;
  }

  .collections .principle-note[open] .principle-toggle svg {
    transform: rotate(90deg);
  }

  .collections .principle-reading {
    padding: 1.5rem;
  }

  .collections .principle-body > :first-child {
    margin-top: 0;
  }

  .collections .principle-body > :last-child {
    margin-bottom: 0;
  }

  .collections .principle-placeholder {
    color: var(--text-muted);
    font-style: italic;
  }

  .collections .principle-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 480px) {
    .collections .principle-note > summary,
    .collections .principle-reading {
      padding: 1.1rem;
    }
  }

  .collections .empty {
    color: var(--text-muted);
    font-style: italic;
  }

  .collections .quote-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .collections .quote-list li {
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: 8px;
    scroll-margin-top: 2rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .collections .quote-list li:hover {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* the excerpt someone was linked to, so a shared link lands somewhere obvious */
  .collections .quote-list li:target {
    border-color: var(--text-muted);
    border-left-color: var(--link);
  }

  /* Base.astro styles blockquotes as muted pull-quotes with a left rule; on this
     page the quote *is* the content, so it gets body color and no rule. */
  .collections .quote-list blockquote {
    margin: 0;
    padding-left: 0;
    border-left: none;
    color: var(--text);
    font-size: 1.05rem;
  }

  /* history, psychology, and neuroscience entries are prose, not quotations, so they get
     ordinary body size rather than the slightly-raised pull-quote size */
  .collections .story {
    font-size: 1rem;
  }

  .collections .quote-list blockquote p,
  .collections .story p {
    margin: 0 0 0.9rem;
  }

  .collections .quote-list blockquote p:last-child,
  .collections .story p:last-child {
    margin-bottom: 0;
  }

  /* the story subject or concept title. It sits above the body, where an idea's
     attribution sits below, because this is a heading rather than a speaker. */
  .collections .subject {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--heading);
  }

  .collections .subject .year {
    font-weight: 400;
    color: var(--text-muted);
  }

  /* a figure from the same source as the quote. These are black-on-white line
     drawings, and a rectangle of paper sitting on the card reads as a slab in
     either theme, so the flat background is blended away instead: multiply drops
     white onto --surface, and dark mode inverts first so screen drops the black.
     Both are lossless only while the art is grayscale, so keep it that way. */
  .collections .quote-figure {
    margin: 1.1rem 0 0;
  }

  .collections .quote-figure img {
    display: block;
    width: min(100%, 460px);
    margin: 0 auto;
    mix-blend-mode: multiply;
  }

  :root[data-theme='dark'] .collections .quote-figure img {
    filter: invert(1);
    mix-blend-mode: screen;
  }

  /* colored art on white: inverting it would hue-flip every fill, so it renders
     plainly and accepts the white panel in dark mode */
  .collections .quote-figure img.plain,
  :root[data-theme='dark'] .collections .quote-figure img.plain {
    mix-blend-mode: normal;
    filter: none;
  }

  .collections .quote-figure figcaption {
    text-align: center;
  }

  /* the share link tracks the BOTTOM of the text block, not the attribution line:
     with a `note` present the attribution is no longer the card's last row, and
     baseline-aligning left the link stranded halfway up the card */
  .collections .meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .collections .meta-text {
    min-width: 0;
  }

  .collections .attribution {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .collections .share {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .collections .share:hover,
  .collections .share:focus-visible {
    color: var(--link);
    background: var(--bg);
  }

  .collections .share.copied,
  .collections .share.copied:hover {
    color: var(--heading);
    background: var(--bg);
  }

  .collections .share svg {
    flex-shrink: 0;
  }

  /* Both labels occupy one grid cell, so the control stays as wide as the longer
     one when the text swaps to "Copied". Without this the label narrows, .meta
     (space-between) hands the freed width to .meta-text, and the commentary
     re-wraps to fewer lines: the whole card visibly shrinks on click. */
  .collections .share-text {
    display: inline-grid;
  }

  .collections .share-text > * {
    grid-area: 1 / 1;
  }

  .collections .share-sizer {
    visibility: hidden;
  }

  /* my own commentary, not the speaker's: the rule and the lighter register are
     what keep the two voices apart once the card is screenshotted or shared */
  .collections .commentary {
    margin: 0.85rem 0 0;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* a short rule rather than a full-width one: --border sits almost on top of
     --surface, so the hairline divider it would draw here is invisible */
  .collections .commentary::before {
    content: '';
    display: block;
    width: 26px;
    margin-bottom: 0.55rem;
    border-top: 2px solid var(--text-muted);
    opacity: 0.45;
  }

  /* the rule introduces the commentary block, so only the first paragraph draws it */
  .collections .commentary + .commentary {
    margin-top: 0.6rem;
  }

  .collections .commentary + .commentary::before {
    display: none;
  }

  .collections .added {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.75;
  }

  .collections .attribution::before {
    content: '\2014\00a0';
  }

  .collections .source {
    font-style: italic;
  }

  .collections .source strong {
    font-style: normal;
  }

  .collections .paraphrased {
    font-style: normal;
  }
</style>
