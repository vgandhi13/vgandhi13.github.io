---
// /ideas/ was renamed to /collections/, where it is now one of two collections.
// This stub keeps links already shared alive. It is a page rather than an entry in
// astro.config's `redirects` because those emit a bare meta-refresh, which drops the
// #fragment: every entry there is individually shareable by design, so the anchor has
// to survive the move. The script carries it across; the meta refresh is the no-JS
// fallback, and /collections/ opens whichever panel the anchor belongs to.
const target = '/collections/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to /collections/</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline>location.replace('/collections/' + location.hash);</script>
  </head>
  <body>
    <p>This page moved to <a href={target}>/collections/</a>.</p>
  </body>
</html>
