---
// /quotes/ was renamed to /ideas/. This stub keeps links already shared alive.
// It is a page rather than an entry in astro.config's `redirects` because those
// emit a bare meta-refresh, which drops the #fragment: every idea here is
// individually shareable by design, so the anchor has to survive the move.
// The script carries it across; the meta refresh is the no-JS fallback.
const target = '/ideas/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to /ideas/</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <script is:inline>location.replace('/ideas/' + location.hash);</script>
  </head>
  <body>
    <p>This page moved to <a href={target}>/ideas/</a>.</p>
  </body>
</html>
