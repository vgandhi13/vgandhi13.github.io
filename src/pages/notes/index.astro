        url: 'https://jax-ml.github.io/scaling-book/inference/',
        label: 'Scaling Book: All About Transformer Inference',
      },
      { url: 'https://github.com/sgl-project/mini-sglang', label: 'mini-sglang' },
      { url: 'https://handbook.modular.com/', label: 'Modular: LLM Inference Handbook' },
      {
        url: 'https://www.aleksagordic.com/blog/vllm',
        label: 'Aleksa Gordić: Inside vLLM',
      },
      { url: 'https://github.com/GeeeekExplorer/nano-vllm', label: 'nano-vllm (GitHub)' },
      {
        url: 'https://huggingface.co/blog/continuous_batching',
        label: 'Hugging Face: Continuous batching',
      },
      { url: 'https://www.tensortonic.com/llm-internals/kv-cache', label: 'Tensortonic: KV cache' },
      {
        url: 'https://www.tensortonic.com/llm-internals/speculative-decoding',
        label: 'Tensortonic: speculative decoding',
      },
    ],
  },
  {
    topic: 'Distributed training - FSDP, tensor parallelism, pipeline parallelism',
    refs: [
      { url: 'https://cs336.stanford.edu/lectures/?trace=lecture_07', label: 'CS336 Lecture 7' },
      {
        url: 'https://github.com/stanford-cs336/lectures/blob/main/lecture_08.pdf',
        label: 'CS336 Lecture 8 (PDF)',
      },
    ],
  },
  {
    topic: 'Attention alternatives and mixture of experts',
    refs: [
      {
        url: 'https://github.com/stanford-cs336/lectures/blob/main/lecture_04.pdf',
        label: 'CS336 Lecture 4 (PDF)',
