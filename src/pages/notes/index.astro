    refs: [
      { url: 'https://lnkd.in/p/efRquAnP', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/eMn6Q95X', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/ezBZi-WT', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/ehPTUUdp', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/emQ_Ppr9', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/ewYwx2Bz', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/eYKVBKkX', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/ez4HiyQH', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/eb2JCshe', label: 'LinkedIn post' },
