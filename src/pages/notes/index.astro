---
import Base from '../../layouts/Base.astro';
import Search from '../../components/Search.astro';
import UpNext from '../../components/UpNext.astro';
import { getCollection } from 'astro:content';

const modifiedDate = (note) => note.data.updated ?? note.data.date;

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => modifiedDate(b).valueOf() - modifiedDate(a).valueOf()
);

// Topics lined up to write about next. Plain strings on purpose: these have no page to
// link to yet, so a note here is one line to add and one line to delete once it ships.
// When a topic does ship, remove it from this list, since the note itself will already
// be sitting at the top of the list above.
const planned = [
  {
    topic: 'LLM Agents: agentic workflows, tool calling, RAG, context engineering, memory systems, and multi-agent orchestration',
    refs: [
      {
        url: 'https://lilianweng.github.io/posts/2023-06-23-agent/',
        label: 'Lilian Weng: LLM Powered Autonomous Agents',
      },
      {
        url: 'https://github.com/walkinglabs/learn-harness-engineering',
        label: 'Learn Harness Engineering (GitHub)',
      },
      {
        url: 'https://www.youtube.com/watch?v=1a1VXDdIyrk',
        label: 'Agent Harness explained in 8min (Video)',
      },
      { url: 'https://lnkd.in/p/ekFS29p8', label: 'LinkedIn post' },
      { url: 'https://www.youtube.com/playlist?list=PLangBM27OtEA', label: 'YouTube playlist' },
    ],
  },
  {
    topic: 'LLM Post-training',
    refs: [
      { url: 'https://lnkd.in/p/es8KZyNW', label: 'LinkedIn post' },
      {
        url: 'https://huggingface.co/spaces/sergiopaniego/train-the-agent-slides',
        label: 'Sergio Paniego: Train the Agent (slides)',
      },
      {
        url: 'https://bespokelabs.ai/blog/teaching-nvidias-nemotron-ml-engineering',
        label: 'Bespoke Labs: Teaching NVIDIA’s Nemotron 3.5 Super-VL ML Engineering',
      },
      {
        url: 'https://www.perplexity.ai/hub/blog/learning-from-real-world-experience',
        label: 'Perplexity',
      },
      {
        url: 'https://arxiv.org/pdf/2505.07608',
        label: 'MiMo technical report (PDF)',
      },
      {
        url: 'https://www.linkedin.com/posts/aleksagordic_very-excited-to-announce-our-new-models-share-7516517658532417537-E0Ts/',
        label: 'Aleksa Gordić: model announcement (LinkedIn)',
      },
    ],
  },
  {
    topic: 'DL',
    refs: [
      {
        url: 'https://alisawuffles.notion.site/alisa-s-book-of-llms?pvs=97#2d17eb873605800a9149c2c8aec7252c',
        label: 'Alisa’s Book of LLMs',
      },
    ],
  },
  {
    topic: 'Transformers',
    refs: [{ url: 'https://lnkd.in/p/gACRvcWM', label: 'LinkedIn post' }],
  },
  'Math: probability, linear algebra, and calculus',
  {
    topic: 'Continual learning',
    refs: [{ url: 'https://nrehiew.github.io/blog/sft_rl_opd/', label: 'nrehiew' }],
  },
  'Reward Model - PRM',
  {
    topic: 'Efficient LLMs - PEFT, LoRA, QLoRA',
    refs: [
      { url: 'https://lnkd.in/p/ektgRQXy', label: 'LinkedIn post' },
      { url: 'https://lnkd.in/p/e9F8-wEk', label: 'LinkedIn post' },
      { url: 'https://thinkingmachines.ai/blog/lora/', label: 'Thinking Machines' },
