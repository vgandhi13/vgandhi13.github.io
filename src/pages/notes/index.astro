---
import Base from '../../layouts/Base.astro';
import Search from '../../components/Search.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Notes · Varun Gandhi" description="Learning notes on AI, LLMs, and post-training.">
  <h1>Notes</h1>
  <p class="intro">
    I've found I retain things far better when I write them up myself.
    I've been documenting my learning notes here since 2026, to share ideas I find
    interesting and to keep a personal reference I can return to when my understanding gets
    rusty. Inspired by
    <a href="https://lilianweng.github.io/" target="_blank" rel="noopener">Lil'Log</a>.
  </p>
  <Search scope="note" />
  <ul class="note-list" id="browse-list">
    {notes.map((note) => (
      <li>
        <span class="note-title">
          <a href={`/notes/${note.id}/`}>{note.data.title}</a>
          {note.data.wip && <span class="wip-badge">in progress</span>}
        </span>
        <span class="date">
          {note.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            timeZone: 'UTC',
          })}
        </span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro {
    color: var(--text-muted);
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .note-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border);
  }

  /* title and badge share one flex item so the badge flows after the title text.
     As a direct flex child it stretched to the row's height, and on a phone, where
     the title wraps to three lines, border-radius: 999px turned that tall box into
     a huge oval floating beside the title. */
  .note-title {
    min-width: 0;
  }

  .wip-badge {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .date {
    color: var(--text-muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }
</style>
