---
import Base from './Base.astro';
import 'katex/dist/katex.min.css';

interface BibliographyEntry {
  id: string;
  authors: string;
  title: string;
  source: string;
  sourcePrefix?: string;
  details?: string;
  year: number;
  url: string;
}

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  description?: string;
  backHref: string;
  backLabel: string;
  wip?: boolean;
  bibliography?: BibliographyEntry[];
}

const {
  title,
  date,
  updated,
  description,
  backHref,
  backLabel,
  wip = false,
  bibliography = [],
} = Astro.props;

const fmt = (d: Date) =>
  // timeZone UTC: frontmatter dates parse as UTC midnight; local formatting shifts a day
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
const showUpdated = updated && fmt(updated) !== fmt(date);
---

<Base title={`${title} · Varun Gandhi`} description={description}>
  <article>
    <p class="back"><a href={backHref}>← {backLabel}</a></p>
    <h1>{title}{wip && <span class="wip-badge">in progress</span>}</h1>
    <p class="entry-date">
      {fmt(date)}{showUpdated && <span class="entry-updated"> · Updated {fmt(updated)}</span>}
    </p>
    <slot />
    {bibliography.length > 0 && (
      <section class="bibliography" aria-labelledby="bibliography">
        <h2 id="bibliography">Bibliography</h2>
        <ol>
          {bibliography.map((entry) => (
            <li id={`ref-${entry.id}`}>
              {/* a title ending in ? or ! keeps its own mark instead of taking a comma */}
              {entry.authors}{', “'}<a href={entry.url}>{entry.title}</a>{/[?!]$/.test(entry.title) ? '” ' : ',” '}
              {entry.sourcePrefix ? `${entry.sourcePrefix} ` : ''}<em>{entry.source}</em>{entry.details ? `, ${entry.details}` : ''}{`, ${entry.year}.`}
            </li>
          ))}
        </ol>
      </section>
    )}
  </article>
</Base>

<style>
  .back {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  article h1 {
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .entry-date {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0;
  }

  .entry-updated {
    font-style: italic;
  }

  .bibliography {
    margin-top: 3rem;
  }

  .bibliography ol {
    counter-reset: bibliography;
    list-style: none;
    padding-left: 0;
  }

  .bibliography li {
    position: relative;
    counter-increment: bibliography;
    padding-left: 2.25rem;
  }

  .bibliography li::before {
    content: '[' counter(bibliography) ']';
    position: absolute;
    left: 0;
  }

  .bibliography li + li {
    margin-top: 0.9rem;
  }

  /* sits on the h1, so it needs its own smaller/lighter type: inheriting the
     heading's size and weight would read as part of the title itself */
  .wip-badge {
    display: inline-block;
    vertical-align: middle;
    margin-left: 0.6rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }
</style>
